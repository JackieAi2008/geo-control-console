# 招商产园 GEO 智控台——运行时配置
# 复制为 .env，填入真实值。.env 已 gitignore，**不会进仓库**。

# ===== LLM 后端（对话助手）=====
# 优先级：设置 DEEPSEEK_API_KEY → 远端 API；否则回退本机 Ollama
# 推荐生产环境填 DeepSeek key（稳定、无需本机 GPU），开发环境可留空走 Ollama

# DeepSeek（OpenAI 兼容协议，Kimi/智谱/通义也可用此协议）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 本机 Ollama（仅在 DEEPSEEK_API_KEY 为空时生效）
# OLLAMA_URL=http://localhost:11434

# ===== 服务端口 =====
# GEO_PORT=8340

# ===== 子路径前缀（部署在 cmip.alaa.org.cn/geo/ 时设为 /geo）=====
# 此项仅用于生成前端 BASE_URL 提示；实际反代由 nginx 完成
# GEO_BASE_PATH=/geo

# ===== 备份 =====
# BACKUP_KEEP_DAYS=30

# ===== 凭据（将来接 SSO 时启用）=====
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://cmip.alaa.org.cn/geo/auth/sso/callback